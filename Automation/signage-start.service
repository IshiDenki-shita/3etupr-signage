# /etc/systemd/system/signage-start.service

[Unit]
Description=3ETU Signage Start Orchestrator (wakeup -> app -> browser)
After=network-online.target display-manager.service graphical.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root

# 既に動いていた場合でも安全に（状態を揃える）
ExecStart=/usr/bin/systemctl start signage-wakeup.service
ExecStart=/usr/bin/systemctl start signage-app.service
ExecStart=/usr/bin/systemctl start signage-browser.service

# oneshot を「完了済み」として扱う（運用で見やすい）
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target