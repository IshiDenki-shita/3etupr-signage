# /etc/systemd/system/signage-browser.service

[Unit]
Description=3ETU Signage Browser (Chromium kiosk)
Requires=signage-app.service
After=signage-app.service display-manager.service graphical.target

[Service]
Type=simple
User=etupr-admin
Group=etupr-admin
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/etupr-admin/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/bin/bash -lc 'for i in $(seq 1 80); do (echo >"/dev/tcp/127.0.0.1/8080") >/dev/null 2>&1 && exit 0; sleep 0.25; done; exit 1'
ExecStart=/usr/bin/chromium --kiosk --app=http://127.0.0.1:8080 --noerrdialogs --disable-infobars http://127.0.0.1:8080
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group

#----------------------------------------------
KillSignal=SIGKILL
ExecStop=/usr/bin/pkill -9 chromium
#----------------------------------------------

[Install]
WantedBy=graphical.target